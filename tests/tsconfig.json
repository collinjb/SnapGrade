{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "..",
    "outDir": "../.test-build",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/types.ts",
    "../src/lib/scoring.ts",
    "../src/lib/autoCapture.ts",
    "../src/lib/csvFormat.ts",
    "../src/lib/queueCounts.ts",
    "../src/lib/pageDetect.ts",
    "../src/lib/grading/parse.ts",
    "../src/lib/mathFormat.ts",
    "../src/lib/apiKeys.ts"
  ]
}
